asses (99.3%)\nValidation: 994/1000 images with target classes (99.4%)\n\nOverall class distribution:\n  person: 10168 (11.0%)\n  rider: 517 (0.6%)\n  car: 82076 (88.5%)\n","output_type":"stream"},{"name":"stderr","text":"\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"import torch\nimport cv2\nimport numpy as np\nimport os\nfrom torch.utils.data import Dataset, DataLoader\n\nclass BDD10KDataset(Dataset):\n    def __init__(self, img_dir, label_dir, input_size=640, augment=False, classes_to_keep=None):\n        self.img_dir = img_dir\n        self.label_dir = label_dir\n        self.input_size = input_size\n        self.augment = augment\n        self.classes_to_keep = classes_to_keep\n        \n        # Get all label files\n        self.label_files = [f for f in os.listdir(label_dir) if f.endswith('.txt')]\n        \n        # Extract image names from label files\n        self.img_files = []\n        self.labels = []\n        \n        for label_file in self.label_files:\n            base_name = os.path.splitext(label_file)[0]\n            img_path = os.path.join(img_dir, base_name + '.jpg')\n            \n            if os.path.exists(img_path):\n                # Load label\n                with open(os.path.join(label_dir, label_file), 'r') as f:\n                    labels = []\n                    for line in f.read().strip().splitlines():\n                        if len(line):\n                            label = list(map(float, line.split()))\n                            # Filter labels based on classes_to_keep\n                            if self.classes_to_keep is None or int(label[0]) in self.classes_to_keep:\n                                labels.append(label)\n                    \n                    if len(labels):\n                        self.img_files.append(img_path)\n                        self.labels.append(np.array(labels, dtype=np.float32))\n        \n        print(f\"Found {len(self.img_files)} images with labels\")\n    \n    def __len__(self):\n        return len(self.img_files)\n    \n    def __getitem__(self, idx):\n        # Load image\n        img_path = self.img_files[idx]\n        img = cv2.imread(img_path)\n        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n        \n        # Get original dimensions\n        h0, w0 = img.shape[:2]\n        \n        # Resize and pad image\n        img, ratio, pad = self.letterbox(img, self.input_size)\n        \n        # Load label\n        labels = self.labels[idx].copy()\n        if len(labels):\n            # Adjust bounding boxes for resized image\n            labels[:, 1:5] = self.xywhn2xyxy(labels[:, 1:5], ratio[0] * w0, ratio[1] * h0, pad[0], pad[1])\n            labels[:, 1:5] = self.xyxy2xywhn(labels[:, 1:5], img.shape[1], img.shape[0])\n        \n        # Create target tensor\n        nl = len(labels)\n        target = torch.zeros((nl, 6))\n        if nl:\n            target[:, 1:] = torch.from_numpy(labels)\n        \n        # Convert to tensor\n        img = torch.from_numpy(img.transpose(2, 0, 1))\n        img = img.float() / 255.0\n        \n        return img, target, (h0, w0)\n    \n    @staticmethod\n    def letterbox(img, new_shape=640, color=(114, 114, 114), auto=True, scaleFill=False, scaleup=True):\n        # Resize and pad image while meeting stride-multiple constraints\n        shape = img.shape[:2]  # current shape [height, width]\n        if isinstance(new_shape, int):\n            new_shape = (new_shape, new_shape)\n\n        # Scale ratio (new / old)\n        r = min(new_shape[0] / shape[0], new_shape[1] / shape[1])\n        if not scaleup:  # only scale down, do not scale up (for better test mAP)\n            r = min(r, 1.0)\n\n        # Compute padding\n        ratio = r, r  # width, height ratios\n        new_unpad = int(round(shape[1] * r)), int(round(shape[0] * r))\n        dw, dh = new_shape[1] - new_unpad[0], new_shape[0] - new_unpad[1]  # wh padding\n        \n        dw /= 2  # divide padding into 2 sides\n        dh /= 2\n\n        if shape[::-1] != new_unpad:  # resize\n            img = cv2.resize(img, new_unpad, interpolation=cv2.INTER_LINEAR)\n        \n        top, bottom = int(round(dh - 0.1)), int(round(dh + 0.1))\n        left, right = int(round(dw - 0.1)), int(round(dw + 0.1))\n        img = cv2.copyMakeBorder(img, top, bottom, left, right, cv2.BORDER_CONSTANT, value=color)\n        \n        return img, ratio, (dw, dh)\n    \n    @staticmethod\n    def xywhn2xyxy(x, w=640, h=640, padw=0, padh=0):\n        # Convert nx4 boxes from [x, y, w, h] normalized to [x1, y1, x2, y2] where xy1=top-left, xy2=bottom-right\n        y = np.copy(x)\n        y[:, 0] = w * (x[:, 0] - x[:, 2] / 2) + padw  # top left x\n        y[:, 1] = h * (x[:, 1] - x[:, 3] / 2) + padh  # top left y\n        y[:, 2] = w * (x[:, 0] + x[:, 2] / 2) + padw  # bottom right x\n        y[:, 3] = h * (x[:, 1] + x[:, 3] / 2) + padh  # bottom right y\n        return y\n    \n    @staticmethod\n    def xyxy2xywhn(x, w=640, h=640):\n        # Convert nx4 boxes from [x1, y1, x2, y2] to [x, y, w, h] normalized\n        y = np.copy(x)\n        y[:, 0] = ((x[:, 0] + x[:, 2]) / 2) / w  # x center\n        y[:, 1] = ((x[:, 1] + x[:, 3]) / 2) / h  # y center\n        y[:, 2] = (x[:, 2] - x[:, 0]) / w  # width\n        y[:, 3] = (x[:, 3] - x[:, 1]) / h  # height\n        return y\n    \n    @staticmethod\n    def collate_fn(batch):\n        img, target, shapes = zip(*batch)\n        for i, l in enumerate(target):\n            l[:, 0] = i  # add target image index for build_targets()\n        return torch.stack(img, 0), torch.cat(target, 0), shapes","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-25T19:31:57.810210Z","iopub.execute_input":"2025-03-25T19:31:57.810520Z","iopub.status.idle":"2025-03-25T19:31:59.383075Z","shell.execute_reply.started":"2025-03-25T19:31:57.810487Z","shell.execute_reply":"2025-03-25T19:31:59.382314Z"}},"outputs":[],"execution_count":4},{"cell_type":"markdown","source":"## Now that we have analysed the dataset we can load in the filtered one so it is read for training","metadata":{}},{"cell_type":"code","source":"# After model initialization\nprint(f\"Model initialized: {type(model).__name__}\")\nprint(f\"Number of parameters: {sum(p.numel() for p in model.parameters())}\")\nprint(f\"Model structure:\")\nprint(model)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-25T17:03:42.433494Z","iopub.status.idle":"2025-03-25T17:03:42.433866Z","shell.execute_reply":"2025-03-25T17:03:42.433711Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def train(model, train_loader, val_loader, optimizer, device, num_epochs=50):\n    \"\"\"\n    Training loop using the ComputeLoss from utils.py for training,\n    but a separate evaluation method for validation.\n    \n    Args:\n        model: The YOLOv8 model.\n        train_loader: DataLoader for the training set.\n        val_loader: DataLoader for the validation set.\n        optimizer: Optimizer (e.g., SGD or Adam).\n        device: Device (e.g., 'cuda' or 'cpu').\n        num_epochs: Number of training epochs.\n    \"\"\"\n    # Initialize loss function for training\n    loss_params = {\n        'cls': 1.0,  # Classification loss weight\n        'box': 5.0,  # Box loss weight \n        'dfl': 1.5   # Distribution focal loss weight\n    }\n    model = model.to(device)\n    loss_fn = ComputeLoss(model, loss_params)\n    \n    best_metric = 0.0  # Track the best validation metric (higher is better)\n    \n    for epoch in range(num_epochs):\n        # Training phase\n        model.train()  # Set model to training mode\n        running_loss = 0.0\n        \n        for batch_idx, (images, targets, *_) in enumerate(train_loader):\n            # Move data to device\n            images = images.to(device)\n            targets = targets.to(device)\n            \n            # Ensure targets are in the correct format [batch_idx, class_id, x, y, w, h]\n            if targets.shape[1] == 5:  # [class, x, y, w, h] format\n                batch_indices = torch.zeros(targets.shape[0], 1, device=device)\n                for i in range(images.shape[0]):\n                    mask = (batch_indices == i)\n                    batch_indices[mask] = i\n                targets = torch.cat([batch_indices, targets], dim=1)\n            \n            # Zero the gradients\n            optimizer.zero_grad()\n            \n            # Forward pass\n            predictions = model(images)  # Get model predictions\n            \n            # Compute loss using the proper ComputeLoss function\n            loss = loss_fn(predictions, targets)\n            \n            # Backward pass and optimization\n            loss.backward()\n            optimizer.step()\n            \n            # Accumulate loss\n            running_loss += loss.item()\n            \n            # Print progress\n            if batch_idx % 10 == 0:\n                print(f\"Epoch [{epoch+1}/{num_epochs}], Batch [{batch_idx}/{len(train_loader)}], Loss: {loss.item():.4f}\")\n        \n        # Print average loss for the epoch\n        epoch_loss = running_loss / len(train_loader)\n        print(f\"Epoch [{epoch+1}/{num_epochs}], Train Loss: {epoch_loss:.4f}\")\n        \n        # Evaluate on the validation set\n        val_metric = evaluate(model, val_loader, device)\n        print(f\"Epoch [{epoch+1}/{num_epochs}], Validation Metric: {val_metric:.4f}\")\n        \n        # Save the best model (now based on metric, not loss)\n        if val_metric > best_metric:\n            best_metric = val_metric\n            torch.save(model.state_dict(), \"best_model.pth\")\n            print(\"Best model saved!\")\n    \n    print(\"Training complete!\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-25T19:32:15.228553Z","iopub.execute_input":"2025-03-25T19:32:15.229048Z","iopub.status.idle":"2025-03-25T19:32:15.241926Z","shell.execute_reply.started":"2025-03-25T19:32:15.229018Z","shell.execute_reply":"2025-03-25T19:32:15.241091Z"}},"outputs":[],"execution_count":5},{"cell_type":"code","source":"@torch.no_grad()\ndef evaluate(model, val_loader, device):\n    \"\"\"Simple evaluation function that just counts detections\"\"\"\n    model.eval()\n    \n    total_gt = 0  # total ground truth objects\n    total_pred = 0  # total predictions\n    correct_pred = 0  # predictions that match ground truth\n    \n    for images, targets, *_ in val_loader:\n        images = images.to(device)\n        targets = targets.to(device)\n        \n        # Forward pass\n        outputs = model(images)\n        \n        # Apply NMS with very low threshold\n        outputs = non_max_suppression(outputs, 0.01, 0.45)\n        \n        # Count ground truth objects\n        total_gt += len(targets)\n        \n        # Count predictions\n        for output in outputs:\n            if output is not None:\n                total_pred += len(output)\n                \n                # Here you would normally count correct_pred based on IoU\n                # but for simplicity, let's just count all predictions\n                correct_pred += len(output)\n        \n    # Calculate metrics\n    precision = correct_pred / total_pred if total_pred > 0 else 0\n    recall = correct_pred / total_gt if total_gt > 0 else 0\n    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0\n    \n    print(f\"Total GT: {total_gt}, Total Pred: {total_pred}, Correct: {correct_pred}\")\n    print(f\"Precision: {precision:.4f}, Recall: {recall:.4f}, F1: {f1:.4f}\")\n    \n    return f1  # Return F1 score as the validation metric","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-25T20:02:03.965141Z","iopub.execute_input":"2025-03-25T20:02:03.965632Z","iopub.status.idle":"2025-03-25T20:02:03.972704Z","shell.execute_reply.started":"2025-03-25T20:02:03.965596Z","shell.execute_reply":"2025-0