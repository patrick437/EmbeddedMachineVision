ce(x, torch.Tensor) and len(x.shape) == 3:\n                output = x\n            else:\n                print(f\"Unexpected output format: {type(x)}, shape: {x.shape if isinstance(x, torch.Tensor) else 'N/A'}\")\n                # Try to convert to the expected format if possible\n                if isinstance(x, torch.Tensor):\n                    batch_size = x.shape[0]\n                    try:\n                        output = x.view(batch_size, self.no, -1)\n                    except RuntimeError:\n                        print(\"Failed to reshape tensor, using dummy tensor for debugging\")\n                        # Create a dummy tensor with expected structure for debugging\n                        output = torch.zeros((batch_size, self.no, 100), device=self.device)\n                else:\n                    # If we can't handle the format, use a dummy tensor\n                    output = torch.zeros((1, self.no, 100), device=self.device)\n        else:\n            # Original behavior for list of feature maps\n            try:\n                output = torch.cat([i.view(x[0].shape[0], self.no, -1) for i in x], 2)\n            except RuntimeError as e:\n                print(f\"Error in cat operation: {e}\")\n                # Fallback to prevent training from crashing\n                output = torch.zeros((x[0].shape[0], self.no, 100), device=self.device)\n        \n        # Continue with the rest of your loss function\n        pred_output, pred_scores = output.split((4 * self.dfl_ch, self.nc), 1)\n    \n        pred_output = pred_output.permute(0, 2, 1).contiguous()\n        pred_scores = pred_scores.permute(0, 2, 1).contiguous()\n    \n        size = torch.tensor(x[0].shape[2:] if isinstance(x, list) else x.shape[2:], \n                          dtype=pred_scores.dtype, device=self.device)\n        size = size * self.stride[0]\n    \n        anchor_points, stride_tensor = make_anchors(x, self.stride, 0.5)\n    \n        # targets\n        if targets.